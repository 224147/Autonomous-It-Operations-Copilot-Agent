# Copy to .env and adjust. NEVER commit a real .env (it is git-ignored).
# In Kubernetes these come from a Secret / HashiCorp Vault - see docs/deployment.md.

# ---- general -------------------------------------------------------------
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
LOG_JSON=false                      # true in production for structured logs
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173  # exact browser origin(s), also enforced for Socket.IO; '*' rejected in production
WORKER_ENABLED=true                 # run the workflow workers + scheduler in this process
WORKER_CONCURRENCY=2
SEED_DEMO_DATA=false                # true = seed the demo service inventory (development only)

# ---- datastores ----------------------------------------------------------
DATABASE_URL=sqlite:///./data/copilot.db        # production: postgresql+psycopg://user:pass@host:5432/copilot
DB_AUTO_CREATE=true                             # production: false, run `alembic upgrade head` instead
REDIS_URL=                                      # e.g. redis://redis:6379/0 (empty = in-process memory, single replica only)
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_HOST=                                    # set to use a Chroma server (required for >1 replica)
CHROMA_PORT=8000

# ---- authentication / security --------------------------------------------
JWT_SECRET=                                     # REQUIRED in production, >= 32 chars (openssl rand -base64 48)
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
BOOTSTRAP_ADMIN_EMAIL=                          # first-run administrator (only used while the users table is empty)
BOOTSTRAP_ADMIN_PASSWORD=                       # >= 10 chars with letters and digits; remove after first login
INGEST_API_KEYS=                                # comma separated keys for collectors / CI (X-API-Key header)
METRICS_TOKEN=                                  # optional bearer token required for GET /metrics

# ---- Azure Entra ID SSO (optional) -----------------------------------------
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_ROLE_MAP={"<group-or-app-role-id>":"admin"}   # JSON: group object id / app role -> viewer|operator|approver|admin
ENTRA_DEFAULT_ROLE=viewer

# ---- HashiCorp Vault (optional; values override env vars) ------------------
VAULT_ADDR=
VAULT_TOKEN=
VAULT_K8S_ROLE=                                 # use Kubernetes auth instead of a static token
VAULT_KV_MOUNT=secret
VAULT_SECRET_PATH=autonomous-it-ops-copilot

# ---- LLM / embeddings (optional; deterministic fallbacks are used when unset) --
LLM_PROVIDER=auto                               # auto | openai | azure | none
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=              # deployment of text-embedding-3-large

# ---- remediation -------------------------------------------------------------
REMEDIATION_MODE=dry_run                        # dry_run (default, safe) | live
REMEDIATION_ALLOWED_NAMESPACES=production       # comma separated allow-list; empty = any inventoried namespace
REMEDIATION_COOLDOWN_SECONDS=300
AUTO_APPROVE_MAX_RISK=none                      # none | low
APPROVAL_TTL_MINUTES=60
CACHE_REDIS_URL=                                # Redis used by clear_cache (service-prefix deletion only)
AWS_REGION=                                     # restart_vm via EC2 (credentials from the environment / IRSA)
TICKET_WEBHOOK_URL=                             # ITSM webhook for open_ticket (ServiceNow / Jira automation / ...)
TICKET_WEBHOOK_TOKEN=
VERIFY_WAIT_SECONDS=60
VERIFY_POLL_SECONDS=10
MAX_REMEDIATION_ATTEMPTS=2

# ---- monitoring integrations ----------------------------------------------------
PROMETHEUS_URL=                                 # e.g. http://prometheus:9090 (pulled into the signal store)
PROMETHEUS_QUERIES_FILE=                        # optional JSON {metric_name: promql}; see monitoring/metric_ingestion
LOKI_URL=
POLL_INTERVAL_SECONDS=30
DETECTION_SWEEP_SECONDS=30
DETECTION_WINDOW_MINUTES=15
INCIDENT_DEDUP_MINUTES=60

# ---- platform self-observability --------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=                    # e.g. http://jaeger:4318 (traces of the platform itself)
OTEL_SERVICE_NAME=autonomous-it-ops-copilot
