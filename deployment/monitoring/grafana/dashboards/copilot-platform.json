{
  "uid": "copilot-platform",
  "title": "Autonomous IT Ops Copilot - Platform Health",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Agent latency p95 (s)", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "histogram_quantile(0.95, sum by (le, agent) (rate(copilot_agent_duration_seconds_bucket[5m])))", "legendFormat": "{{agent}}"}]},
    {"id": 2, "type": "stat", "title": "RCA accuracy (responder feedback)", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1,
       "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 0.7}, {"color": "green", "value": 0.85}]}}},
     "targets": [{"expr": "copilot_rca_accuracy_ratio"}]},
    {"id": 3, "type": "stat", "title": "Open incidents", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "copilot_incidents_open"}]},
    {"id": 4, "type": "timeseries", "title": "Alert processing time p95 (s)", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(copilot_alert_processing_seconds_bucket[15m])))"}]},
    {"id": 5, "type": "timeseries", "title": "Incident resolution time p50/p95 (s)", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "histogram_quantile(0.5, sum by (le) (rate(copilot_incident_resolution_seconds_bucket[6h])))", "legendFormat": "p50"},
                 {"expr": "histogram_quantile(0.95, sum by (le) (rate(copilot_incident_resolution_seconds_bucket[6h])))", "legendFormat": "p95"}]},
    {"id": 6, "type": "timeseries", "title": "API latency p95 by route (s)", "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "histogram_quantile(0.95, sum by (le, route) (rate(copilot_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}"}]},
    {"id": 7, "type": "timeseries", "title": "API error ratio", "gridPos": {"x": 12, "y": 16, "w": 6, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "percentunit"}},
     "targets": [{"expr": "sum(rate(copilot_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(copilot_http_requests_total[5m])), 1)"}]},
    {"id": 8, "type": "stat", "title": "Availability (30d)", "gridPos": {"x": 18, "y": 16, "w": 6, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"}, "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 3}},
     "targets": [{"expr": "avg_over_time(up{job=\"copilot-backend\"}[30d])"}]},
    {"id": 9, "type": "timeseries", "title": "Remediation actions by status", "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "sum by (action, status) (increase(copilot_remediation_actions_total[1h]))", "legendFormat": "{{action}} {{status}}"}]},
    {"id": 10, "type": "timeseries", "title": "Workflow queue depth", "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "copilot_workflow_queue_depth"}]}
  ]
}
